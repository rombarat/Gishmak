# --- Set these in Vercel → Project → Settings → Environment Variables ---

# PostgreSQL. Added automatically when you connect a Neon database in Vercel → Storage.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Optional: direct (unpooled) URL used for migrations. Neon adds DATABASE_URL_UNPOOLED automatically.
# DATABASE_URL_UNPOOLED="postgresql://..."

# Session signing secret, 32+ random characters (e.g. https://generate-secret.vercel.app/32)
SESSION_SECRET=""

# Owner account, created on the first deploy
ADMIN_EMAIL="owner@gishmak.co.il"
ADMIN_PASSWORD=""

# Optional: "true" adds 10 demo orders on the first deploy only (empty database)
SEED_SAMPLE_ORDERS="false"

# Optional: added automatically when you connect Vercel Blob (product image uploads)
# BLOB_READ_WRITE_TOKEN=""
